# expect: review
# rules: diff-docker-remote-add diff-pipe-to-shell diff-new-host
# An image build that adds a file from a URL without a checksum and runs a
# downloaded installer.
diff --git a/Dockerfile b/Dockerfile
index 1111111..2222222 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,3 +1,5 @@
 FROM debian:12-slim
+ADD https://downloads.tool-cdn.dev/agent.tar.gz /opt/agent.tar.gz
+RUN curl -sSL https://get.tool-cdn.dev/install.sh | bash
 COPY . /app
 CMD ["/app/run"]
