  (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/[pP][rR][oO][jJ]/(.*/)?\\.[oO][pP][eE][nN][cC][lL][aA][wW]/[eE][xX][tT][eE][nN][sS][iI][oO][nN][sS](/.*)?$")
