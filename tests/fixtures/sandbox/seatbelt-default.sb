  (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[mM][oO][aA][tT]/[mM][cC][pP](/.*)?$")
  (regex "^(.*/)?\\.[mM][oO][aA][tT]/[aA][uU][dD][iI][tT]\\.[dD][bB][^/]*$")
  (regex "^(.*/)?\\.[mM][oO][aA][tT]/[pP][oO][lL][iI][cC][yY]\\.[lL][oO][cC][kK]$"))
