(version 1)
; generated by OpenMoat from policy.yaml for `openmoat run` (Lightweight tier, ADR-018)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow pseudo-tty)
(allow file-ioctl)
(allow ipc-posix-shm* ipc-posix-sem)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership"))
; seatbelt.metadata
(allow file-read-metadata)
; seatbelt.platform
(allow file-read*
  (literal "/")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/tty")
  (subpath "/dev/fd")
  (subpath "/private/var/select"))
; seatbelt.platform
(allow file-write-data
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/dtracehelper")
  (subpath "/dev/fd"))
; seatbelt.terminal
(allow file-read* file-write-data
  (literal "/dev/ttys003"))
; seatbelt.program
(allow file-read*
  (literal "/Users/me/.local/share/agent/1.0/agent"))
; allow project-fs (fs.read)
(allow file-read*
  (subpath "/Users/me/proj"))
; allow agent-temp (fs.read)
(allow file-read*
  (regex "^/tmp/claude-[^/]*(/.*)?$")
  (regex "^/private/tmp/claude-[^/]*(/.*)?$"))
; sandbox.read_roots
(allow file-read*
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/lib")
  (subpath "/lib64")
  (subpath "/etc")
  (subpath "/opt")
  (subpath "/nix")
  (subpath "/snap")
  (subpath "/System")
  (subpath "/Library")
  (subpath "/Applications/Xcode.app")
  (subpath "/private/etc")
  (subpath "/tmp")
  (subpath "/private/tmp")
  (subpath "/var/folders")
  (subpath "/private/var/folders")
  (subpath "/Users/me/.gitconfig")
  (subpath "/Users/me/.cargo")
  (subpath "/Users/me/.rustup")
  (subpath "/Users/me/.npm")
  (subpath "/Users/me/.nvm")
  (subpath "/Users/me/.pyenv")
  (subpath "/Users/me/.local/bin")
  (subpath "/Users/me/go"))
; allow project-fs (fs.write)
(allow file-write*
  (require-all
    (require-any
      (subpath "/Users/me/proj"))
    (require-not (require-any
      (subpath "/Users/me/proj/.git")
      (regex "^/Users/me/proj/(.*/)?\\.git(/.*)?$")
      (subpath "/Users/me/proj/.moat")
      (regex "^/Users/me/proj/(.*/)?\\.claude/hooks(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.mcp\\.json$")
      (regex "^/Users/me/proj/(.*/)?\\.cursor/mcp\\.json$")
      (regex "^/Users/me/proj/(.*/)?\\.codex/config\\.toml$")
      (regex "^/Users/me/proj/(.*/)?\\.openclaw/extensions(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.github/hooks(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.github/mcp\\.json$")
      (regex "^/Users/me/proj/(.*/)?\\.pi/extensions(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.pi/mcp\\.json$")
      (regex "^/Users/me/proj/(.*/)?\\.pi/settings\\.json$")
      (regex "^/Users/me/proj/(.*/)?\\.opencode/plugins(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.opencode/plugin(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.opencode/tools(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.opencode/tool(/.*)?$")
      (regex "^/Users/me/proj/(.*/)?\\.opencode/opencode\\.json$")
      (regex "^/Users/me/proj/(.*/)?\\.opencode/opencode\\.jsonc$")
      (regex "^/Users/me/proj/(.*/)?opencode\\.json$")
      (regex "^/Users/me/proj/(.*/)?opencode\\.jsonc$")
      (regex "^/Users/me/proj/(.*/)?\\.hermes/plugins(/.*)?$")))))
; seatbelt.tmpdir
(allow file-read* file-write*
  (subpath "/private/var/folders/xy/T"))
; seatbelt.write
(allow file-read* file-write*
  (subpath "/Users/me/.agent"))
; deny secrets-paths (fs.read)
(deny file-read-data file-read-xattr
  (require-all
    (require-any
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[sS][sS][hH](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[aA][wW][sS](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[gG][nN][uU][pP][gG](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[cC][oO][nN][fF][iI][gG]/[gG][hH](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[nN][eE][tT][rR][cC]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[aA][uU][tT][hH][iI][nN][fF][oO]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[aA][uU][tT][hH][iI][nN][fF][oO]\\.[gG][pP][gG]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[dD][oO][cC][kK][eE][rR]/[cC][oO][nN][fF][iI][gG]\\.[jJ][sS][oO][nN]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[cC][oO][nN][fF][iI][gG]/[cC][oO][nN][tT][aA][iI][nN][eE][rR][sS]/[aA][uU][tT][hH]\\.[jJ][sS][oO][nN]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[cC][oO][nN][fF][iI][gG]/[dD][oO][cC][tT][lL]/[cC][oO][nN][fF][iI][gG]\\.[yY][aA][mM][lL]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[kK][uU][bB][eE](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[cC][oO][nN][fF][iI][gG]/[gG][cC][lL][oO][uU][dD](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[aA][zZ][uU][rR][eE](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[gG][iI][tT]-[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[nN][pP][mM][rR][cC]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[pP][yY][pP][iI][rR][cC]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[cC][aA][rR][gG][oO]/[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[cC][aA][rR][gG][oO]/[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]\\.[tT][oO][mM][lL]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[gG][eE][mM]/[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[pP][gG][pP][aA][sS][sS]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[mM][yY]\\.[cC][nN][fF]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[mM][yY][lL][oO][gG][iI][nN]\\.[cC][nN][fF]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[vV][aA][uU][lL][tT]-[tT][oO][kK][eE][nN]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[tT][eE][rR][rR][aA][fF][oO][rR][mM]\\.[dD]/[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]\\.[tT][fF][rR][cC]\\.[jJ][sS][oO][nN]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[cC][oO][nN][fF][iI][gG]/[oO][pP](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[pP][aA][sS][sS][wW][oO][rR][dD]-[sS][tT][oO][rR][eE](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[lL][oO][cC][aA][lL]/[sS][hH][aA][rR][eE]/[kK][eE][yY][rR][iI][nN][gG][sS](/.*)?$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[zZ][sS][hH]_[hH][iI][sS][tT][oO][rR][yY]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[bB][aA][sS][hH]_[hH][iI][sS][tT][oO][rR][yY]$")
      (regex "^(.*/)?\\.[eE][nN][vV]$")
      (regex "^(.*/)?\\.[eE][nN][vV]\\.[^/]*$")
      (regex "^(.*/)?\\.[eE][nN][vV][rR][cC]$")
      (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/[lL][iI][bB][rR][aA][rR][yY]/[kK][eE][yY][cC][hH][aA][iI][nN][sS](/.*)?$"))
    (require-not (require-any
      (regex "^(.*/)?\\.env\\.example$")
      (regex "^(.*/)?\\.env\\.sample$")
      (regex "^(.*/)?\\.env\\.template$")))))
; deny kernel-self (fs.read)
(deny file-read-data file-read-xattr
  (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/\\.[mM][oO][aA][tT]/[aA][uU][dD][iI][tT]\\.[dD][bB][^/]*$")
