(version 1)
; generated by OpenMoat from policy.yaml for `openmoat run` (Lightweight tier, ADR-018)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow pseudo-tty)
(allow file-ioctl)
(allow ipc-posix-shm* ipc-posix-sem)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership"))
; seatbelt.metadata
(allow file-read-metadata)
; seatbelt.platform
(allow file-read*
  (literal "/")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/tty")
  (regex "^/dev/ttys[0-9][^/]*$")
  (subpath "/dev/fd")
  (subpath "/private/var/select"))
; seatbelt.platform
(allow file-write-data
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/dtracehelper")
  (regex "^/dev/ttys[0-9][^/]*$")
  (subpath "/dev/fd"))
; seatbelt.program
(allow file-read*
  (literal "/Users/me/.local/share/agent/1.0/agent"))
; allow project-fs (fs.read)
(allow file-read*
  (subpath "/Users/me/proj"))
; allow agent-temp (fs.read)
(allow file-read*
  (regex "^/tmp/claude-[^/]*(/.*)?$")
  (regex "^/private/tmp/claude-[^/]*(/.*)?$"))
; sandbox.read_roots
(allow file-read*
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/lib")
  (subpath "/lib64")
  (subpath "/etc")
  (subpath "/opt")
  (subpath "/nix")
  (subpath "/snap")
  (subpath "/System")
  (subpath "/Library")
  (subpath "/Applications/Xcode.app")
  (subpath "/private/etc")
  (subpath "/tmp")
  (subpath "/private/tmp")
  (subpath "/var/folders")
  (subpath "/private/var/folders")
  (subpath "/Users/me/.gitconfig")
  (subpath "/Users/me/.cargo")
  (subpath "/Users/me/.rustup")
  (subpath "/Users/me/.npm")
  (subpath "/Users/me/.nvm")
  (subpath "/Users/me/.pyenv")
  (subpath "/Users/me/.local/bin")
  (subpath "/Users/me/go"))
; allow project-fs (fs.write)
(allow file-write*
  (require-all
    (require-any
      (subpath "/Users/me/proj"))
    (require-not (require-any
      (subpath "/Users/me/proj/.git")
      (regex "^/Users/me/proj/(.*/)?\\.git(/.*)?$")
      (subpath "/Users/me/proj/.moat")))))
; seatbelt.tmpdir
(allow file-read* file-write*
  (subpath "/private/var/folders/xy/T"))
; seatbelt.write
(allow file-read* file-write*
  (subpath "/Users/me/.agent"))
; deny secrets-paths (fs.read)
(deny file-read-data file-read-xattr
  (require-all
    (require-any
      (subpath "/Users/me/.ssh")
      (subpath "/Users/me/.aws")
      (subpath "/Users/me/.gnupg")
      (subpath "/Users/me/.config/gh")
      (literal "/Users/me/.netrc")
      (literal "/Users/me/.authinfo")
      (literal "/Users/me/.authinfo.gpg")
      (literal "/Users/me/.docker/config.json")
      (literal "/Users/me/.config/containers/auth.json")
      (literal "/Users/me/.config/doctl/config.yaml")
      (subpath "/Users/me/.kube")
      (subpath "/Users/me/.config/gcloud")
      (subpath "/Users/me/.azure")
      (literal "/Users/me/.git-credentials")
      (literal "/Users/me/.npmrc")
      (literal "/Users/me/.pypirc")
      (literal "/Users/me/.cargo/credentials")
      (literal "/Users/me/.cargo/credentials.toml")
      (literal "/Users/me/.gem/credentials")
      (literal "/Users/me/.pgpass")
      (literal "/Users/me/.my.cnf")
      (literal "/Users/me/.mylogin.cnf")
      (literal "/Users/me/.vault-token")
      (literal "/Users/me/.terraform.d/credentials.tfrc.json")
      (subpath "/Users/me/.config/op")
      (subpath "/Users/me/.password-store")
      (subpath "/Users/me/.local/share/keyrings")
      (literal "/Users/me/.zsh_history")
      (literal "/Users/me/.bash_history")
      (regex "^(.*/)?\\.env$")
      (regex "^(.*/)?\\.env\\.[^/]*$")
      (regex "^(.*/)?\\.envrc$")
      (subpath "/Users/me/Library/Keychains"))
    (require-not (require-any
      (regex "^(.*/)?\\.env\\.example$")
      (regex "^(.*/)?\\.env\\.sample$")
      (regex "^(.*/)?\\.env\\.template$")))))
; deny kernel-self (fs.read)
(deny file-read-data file-read-xattr
  (regex "^/Users/me/\\.moat/audit\\.db[^/]*$")
  (literal "/Users/me/.moat/policy.lock")
  (literal "/Users/me/.moat/hosts.json")
  (literal "/Users/me/.moat/approvals.json")
  (literal "/Users/me/.moat/trust.json")
  (literal "/Users/me/.moat/allowed_signers")
  (subpath "/Users/me/.moat/mcp")
  (regex "^(.*/)?\\.moat/audit\\.db[^/]*$")
  (regex "^(.*/)?\\.moat/policy\\.lock$"))
; deny secrets-paths (fs.write)
(deny file-write*
  (require-all
    (require-any
      (subpath "/Users/me/.ssh")
      (subpath "/Users/me/.aws")
      (subpath "/Users/me/.gnupg")
      (subpath "/Users/me/.config/gh")
      (literal "/Users/me/.netrc")
      (literal "/Users/me/.authinfo")
      (literal "/Users/me/.authinfo.gpg")
      (literal "/Users/me/.docker/config.json")
      (literal "/Users/me/.config/containers/auth.json")
      (literal "/Users/me/.config/doctl/config.yaml")
      (subpath "/Users/me/.kube")
      (subpath "/Users/me/.config/gcloud")
      (subpath "/Users/me/.azure")
      (literal "/Users/me/.git-credentials")
      (literal "/Users/me/.npmrc")
      (literal "/Users/me/.pypirc")
      (literal "/Users/me/.cargo/credentials")
      (literal "/Users/me/.cargo/credentials.toml")
      (literal "/Users/me/.gem/credentials")
      (literal "/Users/me/.pgpass")
      (literal "/Users/me/.my.cnf")
      (literal "/Users/me/.mylogin.cnf")
      (literal "/Users/me/.vault-token")
      (literal "/Users/me/.terraform.d/credentials.tfrc.json")
      (subpath "/Users/me/.config/op")
      (subpath "/Users/me/.password-store")
      (subpath "/Users/me/.local/share/keyrings")
      (literal "/Users/me/.zsh_history")
      (literal "/Users/me/.bash_history")
      (regex "^(.*/)?\\.env$")
      (regex "^(.*/)?\\.env\\.[^/]*$")
      (regex "^(.*/)?\\.envrc$")
      (subpath "/Users/me/Library/Keychains"))
    (require-not (require-any
      (regex "^(.*/)?\\.env\\.example$")
      (regex "^(.*/)?\\.env\\.sample$")
      (regex "^(.*/)?\\.env\\.template$")))))
; deny destructive (fs.write)
(deny file-write*
  (literal "/Users/me")
  (literal "/")
  (regex "^/dev/disk[^/]*$")
  (regex "^/dev/rdisk[^/]*$")
  (regex "^/dev/sd[^/]*$")
  (regex "^/dev/nvme[^/]*$")
  (regex "^/dev/mmcblk[^/]*$")
  (regex "^/dev/vd[^/]*$")
  (regex "^/dev/xvd[^/]*$"))
; deny kernel-self (fs.write)
(deny file-write*
  (literal "/Users/me/.claude")
  (literal "/Users/me/.cursor")
  (regex "^(.*/)?\\.claude$")
  (regex "^(.*/)?\\.codex$")
  (regex "^(.*/)?\\.cursor$")
  (subpath "/Users/me/.moat")
  (literal "/Users/me/.claude/settings.json")
  (literal "/Users/me/.claude/settings.local.json")
  (subpath "/Users/me/.codex")
  (literal "/Users/me/.cursor/hooks.json")
  (literal "/Users/me/.cursor/sandbox.json")
  (regex "^(.*/)?\\.claude/settings\\.json$")
  (regex "^(.*/)?\\.claude/settings\\.local\\.json$")
  (regex "^(.*/)?\\.cursor/hooks\\.json$")
  (regex "^(.*/)?\\.cursor/sandbox\\.json$")
  (regex "^(.*/)?\\.codex/hooks\\.json$")
  (literal "/Users/me/.openclaw")
  (literal "/Users/me/.openclaw/openclaw.json")
  (subpath "/Users/me/.openclaw/openmoat")
  (subpath "/Users/me/.openclaw/state")
  (literal "/Users/me/.copilot")
  (subpath "/Users/me/.copilot/hooks")
  (literal "/Users/me/.copilot/settings.json")
  (literal "/Users/me/.copilot/config.json")
  (regex "^(.*/)?\\.copilot$")
  (regex "^(.*/)?\\.copilot/hooks(/.*)?$")
  (regex "^(.*/)?\\.copilot/settings\\.json$")
  (regex "^(.*/)?\\.copilot/config\\.json$")
  (regex "^(.*/)?\\.github/copilot/settings\\.json$")
  (regex "^(.*/)?\\.github/copilot/settings\\.local\\.json$")
  (regex "^(.*/)?\\.moat(/.*)?$")
  (regex "^(.*/)?bin/moat$")
  (regex "^(.*/)?bin/moat\\.exe$")
  (regex "^(.*/)?bin/openmoat$")
  (regex "^(.*/)?bin/openmoat\\.exe$")
  (regex "^(.*/)?apps/moat/current$")
  (regex "^(.*/)?apps/moat/[^/]*/moat\\.exe$")
  (regex "^(.*/)?apps/openmoat/current$")
  (regex "^(.*/)?apps/openmoat/[^/]*/moat\\.exe$")
  (regex "^(.*/)?apps/openmoat/[^/]*/openmoat\\.exe$"))
; deny shell-rc (fs.write)
(deny file-write*
  (literal "/Users/me/.zshrc")
  (literal "/Users/me/.bashrc")
  (literal "/Users/me/.bash_profile")
  (literal "/Users/me/.profile")
  (literal "/Users/me/.zprofile")
  (literal "/Users/me/.zshenv"))
; never the keychain: the agent and its scripts share this profile
(deny mach-lookup
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.securityd"))
; never typing into the user's terminal: its shell would run it after the session
(deny file-ioctl (ioctl-command TIOCSTI))
; network: only OpenMoat's egress proxy, which decides each host by the policy
(allow network-outbound (remote ip "localhost:18080"))
; stricter: net `registries`: these hosts are reachable only through OpenMoat's proxy: a program that ignores HTTP(S)_PROXY cannot reach them
; wider: fs.read `seatbelt.metadata`: the existence, size and times of every file stay visible (stat); contents follow the rules
; wider: fs.read `seatbelt.platform`: every process reads these to start
; wider: fs.write `seatbelt.platform`: the devices every process writes
; wider: fs.read `seatbelt.program`: the program `openmoat run` starts, which must be readable to start
; wider: fs.read `sandbox.read_roots`: the hook decides these reads by the rules (ask by default); OS layers allow them so commands can run, and deny rules still win
; wider: fs.write `seatbelt.runs-later`: commands may write CI configuration, commit-hook managers' files and editor tasks (an install runs `husky`); the hook asks before the agent writes one (`runs-later`)
; wider: fs.write `seatbelt.tmpdir`: commands may read and write the temp directory; the hook asks
; wider: fs.write `seatbelt.write`: `openmoat run --write`: commands may read and write these; deny rules still win
; wider: fs.read `seatbelt.case`: Seatbelt compares paths in their on-disk spelling, so a pattern spelled in another case than the file on disk does not match it
