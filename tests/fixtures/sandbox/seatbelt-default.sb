  (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/[pP][rR][oO][jJ]/(.*/)?\\.[oO][pP][eE][nN][cC][oO][dD][eE]/[tT][oO][oO][lL][sS](/.*)?$")
