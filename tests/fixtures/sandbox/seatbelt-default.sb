  (regex "^/[uU][sS][eE][rR][sS]/[mM][eE]/[pP][rR][oO][jJ]/(.*/)?\\.[oO][pP][eE][nN][cC][oO][dD][eE]/[oO][pP][eE][nN][cC][oO][dD][eE]\\.[jJ][sS][oO][nN]$")
