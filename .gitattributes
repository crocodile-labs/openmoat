# Golden files are compared byte for byte; keep them LF on every OS.
tests/fixtures/sandbox/* text eol=lf
# Shell scripts run under `sh` must stay LF on every OS: a CRLF checkout on
# Windows breaks the script and the two-line start `init` recognises Cline's
# hook script by (`host/cline.rs`, `OwnedFile::first_line`).
*.sh text eol=lf
# The default a pre-upgrade policy is compared with; pinned by a checksum test.
crates/openmoat-cli/src/upgrade/*.yaml text eol=lf
