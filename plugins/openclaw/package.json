  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "security",
    "policy"
  ],
  "license": "MIT OR Apache-2.0",
  "name": "@openmoat/openclaw",
  "openclaw": {
    "build": {
      "openclawVersion": "2026.10.5"
    },
    "compat": {
      "minGatewayVersion": "2026.10.5",
      "pluginApi": ">=2026.10.5"
    },
    "extensions": [
      "./openmoat.mjs"
    ]
  },
  "repository": {
    "directory": "plugins/openclaw",
    "type": "git",
    "url": "git+https://github.com/crocodile-labs/openmoat.git"
  },
