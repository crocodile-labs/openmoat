{
  "_comment": "binary is relative to the install directory ({platform} is node's process.platform-process.arch); for Claude Code and OpenCode the npm bin is a stub that only the postinstall replaces, so the platform package's own binary is used. The agents the weekly latest-agent check installs (scripts/ci/latest-agents.sh). checked.version is the release the adapter was last checked against, and checked.source the file that says so; `check.py records` (in the quality gate) fails when that file no longer names the version. payload is the host's golden shell payload, with the JSON pointers of its command and of the verdict in the hook's reply.",
  "claude-code": {
    "host": "claude-code",
    "name": "Claude Code",
    "install": "npm",
    "package": "@anthropic-ai/claude-code",
    "binary": "node_modules/@anthropic-ai/claude-code-{platform}/claude",
    "checked": {"version": "2.1.290", "source": "scripts/ci/host-binaries.sh"},
    "config": [["{CLAUDE_CONFIG_DIR}/settings.json", "json"]],
    "payload": {"fixture": "claude_code/fixtures/bash.json", "command": "/tool_input/command",
                "verdict": "/hookSpecificOutput/permissionDecision"},
    "runners": ["ubuntu-latest", "macos-14"]
  },
  "codex": {
    "host": "codex",
    "name": "Codex",
    "install": "npm",
    "package": "@openai/codex",
    "binary": "node_modules/.bin/codex",
    "checked": {"version": "0.160.1", "source": "scripts/ci/host-binaries.sh"},
    "config": [["{CODEX_HOME}/hooks.json", "json"]],
    "payload": {"fixture": "codex/fixtures/pretooluse-shell.json", "command": "/tool_input/command",
                "verdict": "/hookSpecificOutput/permissionDecision"},
    "runners": ["ubuntu-latest", "macos-14"]
  },
